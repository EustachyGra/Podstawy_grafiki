<Window x:Class="Client.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Client" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Row="0" Grid.Column="0" Margin="5">
            <StackPanel x:Name="lstUsers" Orientation="Vertical">
                <Button Content="Użytkownik 1" Height="26"/>
            </StackPanel>
        </ScrollViewer>

        <ListBox x:Name="lstMessages" Grid.Row="0" Grid.Column="1" Margin="5,5,5,35" Grid.RowSpan="2"/>

        <Grid Grid.Row="1" Grid.Column="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtMessage" Grid.Column="0" Height="30" KeyDown="SendMessage_Enter" Margin="0,0,5,0"/>

            <Button Content="Wyślij" Grid.Column="1" Width="75" Height="30" Click="SendMessage_Click"/>
        </Grid>
        <Label x:Name="Connection" Content="Connection: Offline" Foreground="Red" HorizontalAlignment="Center" VerticalAlignment="Center" Width="130" Grid.Row="1"/>

    </Grid>
</Window>
