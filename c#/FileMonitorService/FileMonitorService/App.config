<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
	</startup>

	<appSettings>
		<add key="Sciezka" value="C:\Monitorowany"/>
		<add key="Dziennik" value="MonitorZdarzenDziennik"/>
		<add key="Zrodlo" value="MonitorZdarzenZrodlo"/>
	</appSettings>

	<system.diagnostics>
		<switches>
			<add name="Logowanie" value="Info"/>
		</switches>
	</system.diagnostics>
</configuration>
