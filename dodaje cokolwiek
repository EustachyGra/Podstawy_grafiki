#include <UnoR4WiFi_WebServer.h>

// =======================
// KONFIGURACJA
// =======================

const char WIFI_SSID[]     = "TWOJA_SIEC_WIFI";
const char WIFI_PASSWORD[] = "TWOJE_HASLO";

// =======================


// Strona WWW – wysyła aktualny czas komputera
const char HTML_PAGE[] =
  "<!DOCTYPE html>"
  "<html><head><meta charset='utf-8'></head>"
  "<body>"
  "<h2>Synchronizacja czasu</h2>"
  "<button onclick='sendTime()'>Wyslij czas</button>"

  "<script>"
  "function sendTime(){"
  "  const d = new Date();"
  "  fetch(`/time?"
  "h=${d.getHours()}"
  "&m=${d.getMinutes()}"
  "&s=${d.getSeconds()}`);"
  "}"
  "</script>"

  "</body></html>";


// =======================
// ZMIENNE CZASU
// =======================

int godzina = 0;
int minuta  = 0;
int sekunda = 0;

unsigned long lastTick = 0;


// =======================
// ODBIÓR CZASU Z WWW
// =======================

void handleTime(WiFiClient& client,
                const String&,
                const String&,
                const QueryParams& params,
                const String&) {

  if (params.contains("h") && params.contains("m") && params.contains("s")) {
    godzina = params.get("h").toInt();
    minuta  = params.get("m").toInt();
    sekunda = params.get("s").toInt();

    lastTick = millis();

    Serial.print("Czas ustawiony: ");
    Serial.print(godzina);
    Serial.print(":");
    Serial.print(minuta);
    Serial.print(":");
    Serial.println(sekunda);
  }

  server.sendResponse(client, HTML_PAGE);
}


// =======================
// LICZENIE CZASU LOKALNIE
// =======================

void tickClock() {
  if (millis() - lastTick >= 1000) {
    lastTick += 1000;

    sekunda++;
    if (sekunda >= 60) {
      sekunda = 0;
      minuta++;
    }
    if (minuta >= 60) {
      minuta = 0;
      godzina++;
    }
    if (godzina >= 24) {
      godzina = 0;
    }

    Serial.print("Czas: ");
    if (godzina < 10) Serial.print("0");
    Serial.print(godzina);
    Serial.print(":");
    if (minuta < 10) Serial.print("0");
    Serial.print(minuta);
    Serial.print(":");
    if (sekunda < 10) Serial.print("0");
    Serial.println(sekunda);
  }
}


// =======================
// SETUP
// =======================

UnoR4WiFi_WebServer server;

void setup() {
  Serial.begin(9600);
  delay(1000);

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  while (WiFi.status() != WL_CONNECTED) delay(500);

  Serial.print("IP Arduino: ");
  Serial.println(WiFi.localIP());

  server.addRoute("/", handleTime);
  server.addRoute("/time", handleTime);
  server.begin();
}


// =======================
// LOOP
// =======================

void loop() {
  server.handleClient();
  tickClock();
}
